{
  "url": "/webhooks",
  "method": "POST",
  "body": {
    "url": "{{webhook.url}}",
    "events": "{{parameters.events}}"
  },
  "response": {
    "data": {
      "externalHookId": "{{body.id}}"
    }
  },
  "log": {
    "sanitize": [
      "request.headers.authorization",
      "response.body.secret"
    ]
  }
}
