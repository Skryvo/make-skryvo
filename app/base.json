{
  "baseUrl": "https://api.skryvo.ai/api/v1/agent",
  "headers": {
    "Authorization": "Bearer {{connection.apiKey}}",
    "Accept": "application/json"
  },
  "timeout": "{{common.timeout}}",
  "response": {
    "error": {
      "message": "[{{statusCode}}] {{ifempty(body.detail; body.message)}}{{if(body.details; \": \" + join(map(body.details; \"message\"); \"; \") + \" (\" + join(map(body.details; \"field\"); \", \") + \")\"; \"\")}}",
      "401": {
        "message": "[{{statusCode}}] {{ifempty(body.detail; body.message)}} Create a new key in Skryvo under Settings › API & agents.",
        "type": "InvalidAccessTokenError"
      },
      "403": {
        "message": "[{{statusCode}}] {{ifempty(body.detail; body.message)}}",
        "type": "DataError"
      },
      "422": {
        "message": "[{{statusCode}}] {{ifempty(body.detail; body.message)}}{{if(body.details; \": \" + join(map(body.details; \"message\"); \"; \") + \" (\" + join(map(body.details; \"field\"); \", \") + \")\"; \"\")}}",
        "type": "DataError"
      },
      "429": {
        "message": "[{{statusCode}}] {{ifempty(body.detail; body.message)}}",
        "type": "RateLimitError"
      }
    }
  },
  "log": {
    "sanitize": [
      "request.headers.authorization"
    ]
  }
}
